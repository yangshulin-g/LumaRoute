{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Minimum LumaRoute desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*:*" },
        { "url": "https://*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
