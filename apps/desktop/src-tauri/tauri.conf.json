{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaRoute",
  "version": "0.1.0",
  "identifier": "app.lumaroute.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @lumaroute/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @lumaroute/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaRoute",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["resources/bin/mpv"],
    "resources": [
      "resources/mpv/mpv.lock.json",
      "resources/third-party/*",
      "resources/bin/lib"
    ],
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["mpv"]
      }
    }
  }
}
